{
  "name": "bodymap-app",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "node e2e/d0.e2e.mjs",
    "model:placeholder": "node scripts/make-placeholder.mjs",
    "e2e:webkit": "e2e/run-webkit.sh 390x844 full && e2e/run-webkit.sh 375x667 layout && e2e/run-webkit.sh 390x844 d1",
    "e2e:d1": "node e2e/d1.e2e.mjs",
    "e2e:all": "npm run e2e && npm run e2e:d1 && npm run e2e:a11y",
    "shots": "node e2e/shots.mjs",
    "model:labels": "node scripts/merge-labels.mjs public/model/body.parts.json",
    "e2e:a11y": "node e2e/a11y.e2e.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "0.186.0",
    "axe-core": "4.10.2",
    "playwright-core": "1.64.0",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
